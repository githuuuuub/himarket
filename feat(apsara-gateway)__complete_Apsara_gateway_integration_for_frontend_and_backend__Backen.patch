+      return parsed?.tools?.length || 0;
+    } catch { return 0; }
+  })();
+
+  return (
+    <div onClick={onViewDetail} className="bg-white/70 backdrop-blur-sm rounded-xl p-4 border border-white/50 transition-all duration-300 hover:bg-white hover:shadow-lg hover:scale-[1.02] cursor-pointer relative overflow-hidden group flex flex-col h-[200px]">
