+import { useState, useEffect, useRef, useCallback } from "react";
+import {
+  SearchOutlined, ToolOutlined, ApiOutlined, ThunderboltOutlined,
+  AppstoreOutlined, PlusOutlined, CopyOutlined, SendOutlined,
+  CloudServerOutlined, LinkOutlined, DeleteOutlined, EllipsisOutlined,
+  StopOutlined,
+} from "@ant-design/icons";
+import { Input, Spin, Tag, message, Tabs, Button, Modal, Form, Select, Badge, Popconfirm, Dropdown } from "antd";
+import { useNavigate } from "react-router-dom";
+import { Layout } from "../components/Layout";
+import { CategoryMenu } from "../components/square/CategoryMenu";
+import APIs, { type ICategory } from "../lib/apis";
+import { getIconString } from "../lib/iconUtils";
+import type { IProductDetail } from "../lib/apis/product";
+import type { IMcpCold, IMcpSubscription } from "../lib/apis/mcpMarket";
+import { ProductIconRenderer } from "../components/icon/ProductIconRenderer";
+import dayjs from "dayjs";
+import BackToTopButton from "../components/scroll-to-top";
+
+function McpSquare() {
+  const navigate = useNavigate();
+  const scrollContainerRef = useRef<HTMLDivElement>(null);
+  const [activeTab, setActiveTab] = useState<"market" | "my">("market");
+
+  // ==================== MCP广场(冷数据) ====================
+  const [activeCategory, setActiveCategory] = useState("all");
+  const [searchQuery, setSearchQuery] = useState("");
+  const [products, setProducts] = useState<IProductDetail[]>([]);
+  const [categories, setCategories] = useState<Array<{ id: string; name: string; count: number }>>([]);
+  const [loading, setLoading] = useState(false);
+  const [categoriesLoading, setCategoriesLoading] = useState(false);
+  const [currentPage, setCurrentPage] = useState(0);
+  const [hasMore, setHasMore] = useState(true);
+  const [loadingMore, setLoadingMore] = useState(false);
+  const PAGE_SIZE = 30;
+
+  // ==================== 冷数据(新MCP广场API) ====================
+  const [mcpColdList, setMcpColdList] = useState<IMcpCold[]>([]);
+  const [mcpColdLoading, setMcpColdLoading] = useState(false);
+  const [mcpColdKeyword, setMcpColdKeyword] = useState(""); // eslint-disable-line
+
+  // ==================== 我的MCP(热数据) ====================
+  const [myMcps, setMyMcps] = useState<IMcpSubscription[]>([]);
+  const [myMcpsLoading, setMyMcpsLoading] = useState(false);
+
+  // ==================== 订阅中状态 ====================
+  const [subscribingIds, setSubscribingIds] = useState<Set<number>>(new Set());
+
+  // ==================== 添加MCP弹窗 ====================
+  const [addModalVisible, setAddModalVisible] = useState(false);
+  const [addForm] = Form.useForm();
+  const [addLoading, setAddLoading] = useState(false);
+
+  // 获取分类列表
+  useEffect(() => {
+    const fetchCategories = async () => {
+      setCategoriesLoading(true);
+      try {
+        const response = await APIs.getCategoriesByProductType({ productType: "MCP_SERVER" });
+        if (response.code === "SUCCESS" && response.data?.content) {
+          const categoryList = response.data.content.map((cat: ICategory) => ({
+            id: cat.categoryId, name: cat.name, count: 0,
+          }));
+          setCategories(categoryList.length > 0 ? [{ id: "all", name: "全部", count: 0 }, ...categoryList] : []);
+          setActiveCategory("all");
+        }
+      } catch (error) {
+        console.error("Failed to fetch categories:", error);
+      } finally {
+        setCategoriesLoading(false);
+      }
+    };
+    fetchCategories();
+  }, []);
+
+  // 获取产品列表(原有逻辑，保留兼容)
+  useEffect(() => {
+    if (activeTab !== "market") return;
+    const fetchProducts = async () => {
+      setLoading(true);
+      setProducts([]);
+      setCurrentPage(0);
+      setHasMore(true);
+      try {
+        const categoryIds = activeCategory === "all" ? undefined : [activeCategory];
+        const response = await APIs.getProducts({
+          type: "MCP_SERVER", categoryIds, page: 0, size: PAGE_SIZE,
+        });
+        if (response.code === "SUCCESS" && response.data?.content) {
+          const prods = response.data.content;
+          setProducts(prods);
+          setHasMore(response.data.totalElements > prods.length);
+        }
+      } catch (error) {
+        console.error("Failed to fetch products:", error);
+        message.error("获取MCP Server列表失败");
+      } finally {
+        setLoading(false);
+      }
+    };
+    fetchProducts();
+  }, [activeCategory, activeTab]);
+
+  // 获取MCP广场冷数据
+  const fetchMcpColdList = useCallback(async () => {
+    setMcpColdLoading(true);
+    try {
+      const response = await APIs.getMcpMarketList({
+        keyword: mcpColdKeyword || undefined, page: 0, size: 50,
+      });
+      if (response.code === "SUCCESS" && response.data?.content) {
+        setMcpColdList(response.data.content);
+      }
+    } catch (error) {
+      console.error("Failed to fetch MCP cold list:", error);
+    } finally {
+      setMcpColdLoading(false);
+    }
+  }, [mcpColdKeyword]);
+
+  useEffect(() => {
+    if (activeTab === "market") fetchMcpColdList();
+  }, [activeTab, fetchMcpColdList]);
+
+  // 获取我的MCP
+  const fetchMyMcps = useCallback(async () => {
+    setMyMcpsLoading(true);
+    try {
+      const response = await APIs.getMyMcps();
+      if (response.code === "SUCCESS" && response.data) {
+        setMyMcps(response.data);
+      }
+    } catch (error) {
+      console.error("Failed to fetch my MCPs:", error);
+    } finally {
+      setMyMcpsLoading(false);
+    }
+  }, []);
+
+  useEffect(() => {
+    if (activeTab === "my") fetchMyMcps();
+  }, [activeTab, fetchMyMcps]);
+
+  // 加载更多
+  const loadMoreProducts = useCallback(async () => {
+    if (loadingMore || !hasMore) return;
+    setLoadingMore(true);
+    try {
+      const categoryIds = activeCategory === "all" ? undefined : [activeCategory];
+      const nextPage = currentPage + 1;
+      const response = await APIs.getProducts({
+        type: "MCP_SERVER", categoryIds, page: nextPage, size: PAGE_SIZE,
+      });
+      if (response.code === "SUCCESS" && response.data?.content) {
+        setProducts(prev => [...prev, ...response.data.content]);
+        setCurrentPage(nextPage);
+        setHasMore(response.data.totalElements > products.length + response.data.content.length);
+      }
+    } catch (error) {
+      console.error("Failed to load more:", error);
+    } finally {
+      setLoadingMore(false);
+    }
+  }, [activeCategory, currentPage, hasMore, loadingMore, products]);
+
+  // 滚动加载
+  useEffect(() => {
+    const el = scrollContainerRef.current;
+    if (!el) return;
+    const handleScroll = () => {
+      if (el.scrollHeight - el.scrollTop - el.clientHeight < 200) loadMoreProducts();
+    };
+    el.addEventListener("scroll", handleScroll);
+    return () => el.removeEventListener("scroll", handleScroll);
+  }, [loadMoreProducts]);
+
+  const filteredProducts = products.filter((p) => {
+    if (!searchQuery) return true;
+    const q = searchQuery.toLowerCase();
+    return p.name.toLowerCase().includes(q) || p.description.toLowerCase().includes(q);
+  });
+
+  // ==================== 操作 ====================
+
+  const handleViewDetail = (product: IProductDetail) => navigate(`/mcp/${product.productId}`);
+  const handleTryNow = (product: IProductDetail) => navigate("/chat", { state: { selectedProduct: product } });
+
+  const handleSubscribe = async (mcpColdId: number) => {
+    setSubscribingIds(prev => new Set(prev).add(mcpColdId));
+    try {
+      const response = await APIs.subscribeMcp({ mcpColdId });
+      if (response.code === "SUCCESS") {
+        message.success("订阅成功");
+        fetchMcpColdList();
+        if (activeTab === "my") fetchMyMcps();
+      } else {
+        message.error("订阅失败");
+      }
+    } catch (error: any) {
+      message.error(error?.message || "订阅失败");
+    } finally {
+      setSubscribingIds(prev => { const s = new Set(prev); s.delete(mcpColdId); return s; });
+    }
+  };
+
+  const handleUnsubscribe = async (mcpColdId: number) => {
+    try {
+      const response = await APIs.unsubscribeMcp({ mcpColdId });
+      if (response.code === "SUCCESS") {
+        message.success("已取消订阅");
+        fetchMyMcps();
+      }
+    } catch (error: any) {
+      message.error(error?.message || "取消订阅失败");
+    }
+  };
+
+  const handlePublish = async (mcpColdId: number) => {
+    try {
+      const response = await APIs.publishMcp({ mcpColdId });
+      if (response.code === "SUCCESS") {
+        message.success("已提交发布审核");
+        fetchMyMcps();
+      }
+    } catch (error: any) {
+      message.error(error?.message || "发布失败");
+    }
