+          {/* 底部操作栏 */}
+          <div className="flex items-center justify-between px-6 py-3 border-t border-gray-100">
+            <div>
+              {currentStep > 0 ? (
+                <Button onClick={() => setCurrentStep(currentStep - 1)}>上一步</Button>
+              ) : <span />}
+            </div>
+            <Space>
+              <Button onClick={handleCancel}>取消</Button>
