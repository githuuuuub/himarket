+                  <div className={`pt-0.5 pb-4 cursor-pointer ${isLast ? '' : ''}`}>
+                    <div className={`text-sm leading-tight ${isActive ? 'font-semibold text-gray-900' : isDone ? 'font-medium text-gray-700' : 'text-gray-500'}`}>
+                      {item.label}
